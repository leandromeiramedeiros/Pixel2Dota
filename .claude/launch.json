{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/src/index.js"
      ],
      "port": 2567
    },
    {
      "name": "client",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "client",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "server-cheats",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=tools/cheats.env",
        "server/src/index.js"
      ],
      "port": 2567
    },
    {
      "name": "trainer",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "../InvokerTrainer",
        "--port",
        "5190",
        "--strictPort"
      ],
      "port": 5190
    }
  ]
}
